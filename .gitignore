# build trees, downloads and local package repositories: never in git
build/
/archives/
/i386/
/sparc/
/work/
/distfiles/
# upstream sources unpacked into a component directory by "gmake prep"
packages/**/gcc-[0-9]*.[0-9]*/
packages/**/binutils-[0-9]*.[0-9]*/
packages/**/amix-userland-*/
# binaries and archives
*.tar.gz
*.tar.xz
*.tar.bz2
*.tgz
*.zip
*.p5p
*.o
*.so
*.so.*
*.a
*.bin
*.rom
*.adf
*.hdf
*.iso
*.log
# private files (addresses, access details, correspondence): the name
# carries ".local", and they are never published
*.local
*.local.*
