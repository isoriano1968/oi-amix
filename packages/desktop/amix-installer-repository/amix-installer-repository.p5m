set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="The AMIX packages the AMIX Installer serves to AMIX (Amiga UNIX, m68k) in its network install: an IPS repository, publisher amix, of every amix-userland package, under /usr/share/amix-installer/repo. It holds no Commodore files. These packages are for AMIX, not for this system."
set name=info.classification value="org.opensolaris.category.2008:$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# AMIX (m68k) files: nothing to resolve on this system
<transform file -> default pkg.depend.bypass-generate .*>
# pkgrepo and pkg.client refuse a catalog that its owner cannot write (0444):
# the catalog files 0644, an update always installs its own (preserve=renameold)
<transform file path=usr/share/amix-installer/repo/publisher/amix/catalog/.* -> default mode 0644>
<transform file path=usr/share/amix-installer/repo/publisher/amix/catalog/.* -> default preserve renameold>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
