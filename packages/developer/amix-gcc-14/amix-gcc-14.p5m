#
# developer/amix/gcc-14 -- gcc 14.2.0 (C, C++) and binutils 2.43.1 for
# m68k-elf (AMIX userland), hosted on OpenIndiana.  The file list is
# generated from the proto area (pkgsend generate).  Left out on purpose:
# the gcc plugin development files (lib/gcc/.../plugin/include,
# plugin/gtype.state, libexec/.../plugin/gengtype), libtool .la files, the
# info pages, and libstdc++'s gdb pretty printers (there is no m68k gdb
# here).
#
# Not packaged either: include-fixed.  It holds repaired copies of the AMIX
# system headers (fixincludes plus amix-userland's K&R and C99 fixes), which
# may not be redistributed.  The package ships bin/m68k-amix-fixheaders and
# share/amix-fixheaders instead (the Solaris project's approach); root runs
# m68k-amix-fixheaders once after installing, against the local sysroot.  The AMIX sysroot (--with-sysroot=/opt/m68k-amix-sysroot) is not
# part of the package: it comes from a licensed AMIX installation.
#
# The programs gcc runs from libexec/gcc/m68k-elf/14.2.0 (cc1, cc1plus,
# collect2, lto1, lto-wrapper, install-tools/*) carry mode=0555: oi-userland's
# default transforms make only */bin/* executable, and gcc takes a pass it
# cannot execute for a missing one ("cannot execute 'cc1'").
#
set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="The modern AMIX cross compiler: gcc 14.2.0 with C and C++ (libstdc++, exceptions, RTTI) and binutils 2.43.1 for m68k-elf, the ABI of AMIX 2.1 userland on the Amiga 3000, hosted on OpenIndiana.  Code is 68060-safe (no 64-bit multiply/divide) and runs on 68020 to 68060.  Includes amix-userland's specs, repaired headers and C99 compat library.  Links against the AMIX sysroot in /opt/m68k-amix-sysroot, which this package does not contain: copy it from a licensed AMIX installation."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)

license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'

