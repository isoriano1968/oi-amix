set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="Kernel kit tools for the AMIX Installer: the shared pieces of every driver kit relink (the io_init and level-2 interrupt chains, the loader relocation check), stamp-rootcard.py and kernel-nswap.py, and the kernel-040 kit: amix-kernel-040 makes the 68040/68060 AMIX kernel (generic, or the A3000 + Z3660 line) from the user's own stock AMIX 2.1c kernel. All MIT; no AMIX kernel, Commodore or NetBSD file is included (the Motorola FPSP/060SP code is extracted from the pinned NetBSD 10.1 syssrc.tgz at kernel build time)."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k objects for the AMIX kernel, not for this host
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
# what amix-kernel-040 and kit-relink.sh run: the m68k-elf gcc + binutils
# (/opt/m68k-amix), gcc 2.7.2.3 (m68k-cbm-sysv4-*), python3, m4, patch, tar
depend type=require fmri=developer/amix/gcc-14
depend type=require fmri=developer/amix/gcc-27
depend type=require-any fmri=runtime/python-313 fmri=runtime/python-314 \
    fmri=runtime/python-39
depend type=require fmri=developer/macro/gnu-m4
depend type=require fmri=text/gnu-patch
depend type=require fmri=archiver/gnu-tar
#
