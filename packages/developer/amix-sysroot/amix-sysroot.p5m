#
# developer/amix/sysroot -- the AMIX 2.1c p2a usr/ tree from amigaux/amix-system,
# unchanged but for relative links, plus the sysroot marker.  The file and
# link list is manifests/sample-manifest.p5m as generated (gmake
# sample-manifest); regenerate it when the amix-system commit changes.
#
set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.human-version value="2.1c patch level 2a"
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="The Amiga UNIX (AMIX) 2.1c system headers, libraries, startup objects, X11 and kernel relink kit at patch level 2a, as published in amigaux/amix-system under Amiga Corporation's approval of 2026-09-23, installed as the sysroot /opt/m68k-amix-sysroot for the AMIX cross compilers developer/amix/gcc-27 and developer/amix/gcc-14. Checked against amigaux's MANIFEST.sha256 and SYMLINKS at build time; absolute links are made relative so nothing resolves into the host. etc/amix-sysroot.release names the version and the source commits."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# Development files only; m68k ELF objects and AMIX shell scripts never run
# on the host, so pkgdepend does not analyse them.  Some links dangle as they
# did on AMIX (their targets are not part of amix-system, e.g. /sbin/init or
# /usr/ucbinclude); after the relinking they dangle inside the sysroot.
#
<transform file link dir -> default facet.devel true>
<transform file -> default pkg.depend.bypass-generate .*>
# pkglint's ELF checks (userland.action001) are for host binaries; on some
# 1992 m68k objects without a string table pkg(5)'s ELF reader raises an
# internal error instead of a lint result
<transform file -> default pkg.linted.userland.action001 true>
#
# Left out: six stripped AMIX X clients (usr/X/bin/bmtoa, showrgb, xgc,
# xlsatoms, xlsclients, xlsfonts) have no ELF string table, and pkg(5)'s ELF
# reader (pkgsend publish, pkg verify) fails on them with an internal error.
# Programs are never linked against, so a sysroot does not need them.
<transform link -> default pkg.tmp.allow-dangling true>
<transform link -> default pkg.linted.userland.action002.0 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
