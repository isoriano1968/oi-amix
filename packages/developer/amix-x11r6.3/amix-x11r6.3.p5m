#
# developer/amix/x11r6.3 -- the stage of amix-userland's x11/x11r6.3 (its
# manifest lists the same 331 files) in /opt/m68k-amix-sysroot.  Built on
# 2026-11-15 byte-identical to the Linux workstation build of the same component.
#
set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="X11R6.3 for AMIX in the AMIX sysroot /opt/m68k-amix-sysroot: the client libraries libX11, Xext, Xt, Xmu, Xaw, ICE, SM, Xi, Xau and Xdmcp as shared libraries (libX*.so.7, as on the AMIX systems), their headers in usr/x11r6/include, pkg-config files (x11, xt, xext, xmu, xaw, ice, sm, xi, xau, xdmcp), xauth, and the link stubs AMIX's own ld needs (usr/local/share/amix-stubs/x11r6.3). Cross-built from pristine X11R6.3 and amix-userland's AMIX port with developer/amix/gcc-14."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k development files for the sysroot only; pkgdepend does not analyse
# them and pkg(5)'s ELF checks are for host binaries
<transform file link dir -> default facet.devel true>
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
<transform link -> default pkg.depend.bypass-generate .*>
<transform link -> default pkg.linted.userland.action002.0 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
