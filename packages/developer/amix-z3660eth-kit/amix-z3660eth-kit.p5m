set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="Kernel driver kit(s) for the AMIX Installer: Z3660 Ethernet (/dev/zen0, major 51), z3660net + patches, 68040/68060 port kernels only. No AMIX kernel is included."
set name=pkg.description \
    value="z3660eth kernel driver kit for the AMIX Installer: /dev/zen0, major 51, the Z3660 Ethernet (STREAMS/DLPI, z3660net plus patches), for the 68040/68060 port kernels only."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k objects for the AMIX kernel, not for this host
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
file path=usr/share/amix-installer/z3660eth-040/KIT.info
file path=usr/share/amix-installer/z3660eth-040/KIT.sha256
file path=usr/share/amix-installer/z3660eth-040/LICENSE.z3660net
file path=usr/share/amix-installer/z3660eth-040/check_relink_relocs.py
file path=usr/share/amix-installer/z3660eth-040/patch_io_init.py
file path=usr/share/amix-installer/z3660eth-040/patch_z3660eth_cdevsw.py
file path=usr/share/amix-installer/z3660eth-040/z3660eth_040.o
file path=usr/share/amix-installer/z3660eth-040/z3660eth_kvmap.o
file path=usr/share/amix-installer/z3660eth-040/z3660eth_pad.o
