set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="The z3660rtg AMIX kernel driver (/dev/z3660rtg, major 55: the Z3660 accelerator's RTG) as a kit for the AMIX Installer: our own object files and the relink scripts, which the installer links into a generic 68040/68060 port kernel built on the host. Not for the z3660 kernel variant, which has the Z3660 RTG built in. No AMIX kernel is included."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k objects for the AMIX kernel, not for this host
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
file path=usr/share/amix-installer/z3660rtg-040/KIT.info
file path=usr/share/amix-installer/z3660rtg-040/KIT.sha256
file path=usr/share/amix-installer/z3660rtg-040/check_relink_relocs.py
file path=usr/share/amix-installer/z3660rtg-040/devkvmap040.o
file path=usr/share/amix-installer/z3660rtg-040/patch_io_init.py
file path=usr/share/amix-installer/z3660rtg-040/patch_z3660rtg_cdevsw.py
file path=usr/share/amix-installer/z3660rtg-040/z3660rtg_040.o
file path=usr/share/amix-installer/z3660rtg-040/z3660rtg_pad.o
