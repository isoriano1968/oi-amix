set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="Kernel driver kit for the AMIX Installer: Z3660 SD card storage as a SCSI controller of sd.c (dd disks, block major 18, char major 40), z3660scsi + patches, 68040/68060 port kernels only. No AMIX kernel is included."
set name=pkg.description \
    value="z3660scsi kernel driver kit for the AMIX Installer: the Z3660 accelerator's SD card storage (PiStorm piscsi mailbox, AutoConfig 0x144B:0x01) as one more SCSI controller of the stock sd.c, so its drives are ordinary dd disks (/dev/dsk/cNdUsS, block major 18, char major 40); Jussi Alanärä's z3660scsi plus patches, for the 68040/68060 port kernels only (the Z3660 is a 68060 card)."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k objects for the AMIX kernel, not for this host
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
file path=usr/share/amix-installer/z3660scsi-040/KIT.info
file path=usr/share/amix-installer/z3660scsi-040/KIT.sha256
file path=usr/share/amix-installer/z3660scsi-040/LICENSE.z3660scsi
file path=usr/share/amix-installer/z3660scsi-040/check_relink_relocs.py
file path=usr/share/amix-installer/z3660scsi-040/patch_io_init.py
file path=usr/share/amix-installer/z3660scsi-040/patch_z3660scsi_card.py
file path=usr/share/amix-installer/z3660scsi-040/z3660scsi_040.o
file path=usr/share/amix-installer/z3660scsi-040/z3660scsi_card.o
file path=usr/share/amix-installer/z3660scsi-040/z3660scsi_kvmap.o
file path=usr/share/amix-installer/z3660scsi-040/z3660scsi_pad.o
