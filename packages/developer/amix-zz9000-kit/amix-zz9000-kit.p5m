set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="zz9000 kernel driver kits for the AMIX Installer: /dev/zz9000, major 49, the MNT ZZ9000 on Zorro II, for the stock AMIX 2.1c/2.1p2a 68030 kernel (zz9000) and for a generic 68040/68060 port kernel made by amix-kernel-040 (zz9000-040; the z3660 variant has the driver built in). Per-board colour modes and RTGIOC_GETCAPS. MIT; no AMIX kernel is included."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=info.source-url value=$(COMPONENT_ARCHIVE_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
#
# m68k objects for the AMIX kernel, not for this host
<transform file -> default pkg.depend.bypass-generate .*>
<transform file -> default pkg.linted.userland.action001 true>
#
license $(COMPONENT_LICENSE_FILE) license='$(COMPONENT_LICENSE)'
#
file path=usr/share/amix-installer/zz9000/KIT.info
file path=usr/share/amix-installer/zz9000/KIT.sha256
file path=usr/share/amix-installer/zz9000/check_relink_relocs.py
file path=usr/share/amix-installer/zz9000/patch_io_init.py
file path=usr/share/amix-installer/zz9000/patch_zz9000_cdevsw.py
file path=usr/share/amix-installer/zz9000/zz9000_030.o
file path=usr/share/amix-installer/zz9000/zz9000_pad.o
file path=usr/share/amix-installer/zz9000-040/KIT.info
file path=usr/share/amix-installer/zz9000-040/KIT.sha256
file path=usr/share/amix-installer/zz9000-040/check_relink_relocs.py
file path=usr/share/amix-installer/zz9000-040/patch_io_init.py
file path=usr/share/amix-installer/zz9000-040/patch_zz9000_cdevsw.py
file path=usr/share/amix-installer/zz9000-040/zz9000_040.o
file path=usr/share/amix-installer/zz9000-040/zz9000_pad.o
