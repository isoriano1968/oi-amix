#
# The members, each with the version this set was tested with (minimum
# versions; a newer one satisfies them).  Change a version here when a
# member moves, and the COMPONENT_VERSION of this package with it.
#
set name=pkg.fmri value=pkg:/$(COMPONENT_FMRI)@$(IPS_COMPONENT_VERSION),$(BUILD_VERSION)
set name=pkg.summary value="$(COMPONENT_SUMMARY)"
set name=pkg.description \
    value="Installs a complete Amiga UNIX (AMIX) cross development system: the AMIX 2.1c sysroot (/opt/m68k-amix-sysroot), gcc 2.7.2.3 for the kernel, drivers and modules (/opt/amix-cross), and gcc 14.2.0 with C++ for AMIX applications (/opt/m68k-amix)."
set name=info.classification value="$(COMPONENT_CLASSIFICATION)"
set name=info.upstream-url value=$(COMPONENT_PROJECT_URL)
set name=org.opensolaris.consolidation value=$(CONSOLIDATION)
depend type=require fmri=developer/amix/sysroot@2.1.2
depend type=require fmri=developer/amix/gcc-27@2.7.2.3
depend type=require fmri=developer/amix/gcc-14@14.2.0
